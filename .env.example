# Supabase Configuration
# Get these from: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database connection string
# Get from: https://supabase.com/dashboard/project/_/settings/database
DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# Server
PORT=3001
NODE_ENV=development

# Logging (debug, info, warn, error)
LOG_LEVEL=info

# Anthropic API Key
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-your-key

# Supabase Access Token (for migrations)
# Get from: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=sbp_your-access-token

# ============================================================
# STRIPE (Billing & Subscriptions)
# Get from: https://dashboard.stripe.com/apikeys
# ============================================================
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# App URL (for Stripe redirects)
APP_URL=http://localhost:3001

# ============================================================
# QUICKBOOKS ONLINE
# Get from: https://developer.intuit.com/app/developer/qbo/docs/get-started
# ============================================================
QBO_CLIENT_ID=your-quickbooks-client-id
QBO_CLIENT_SECRET=your-quickbooks-client-secret
QBO_REDIRECT_URI=http://localhost:3001/api/quickbooks/callback
QBO_ENVIRONMENT=sandbox

# ============================================================
# XERO
# Get from: https://developer.xero.com/app/manage
# ============================================================
XERO_CLIENT_ID=your-xero-client-id
XERO_CLIENT_SECRET=your-xero-client-secret
XERO_REDIRECT_URI=http://localhost:3001/api/xero/callback

# ============================================================
# PROCORE (Optional)
# Get from: https://developers.procore.com
# ============================================================
PROCORE_CLIENT_ID=your-procore-client-id
PROCORE_CLIENT_SECRET=your-procore-client-secret
PROCORE_REDIRECT_URI=http://localhost:3001/api/procore/callback

# ============================================================
# SLACK (Optional - for notifications)
# Get from: https://api.slack.com/apps
# ============================================================
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-signing-secret

# ============================================================
# EMAIL (Optional - for notifications)
# ============================================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
EMAIL_FROM=noreply@yourdomain.com

# ============================================================
# WEATHER API (Optional - for delay tracking)
# Get from: https://openweathermap.org/api
# ============================================================
OPENWEATHER_API_KEY=your-openweather-api-key
