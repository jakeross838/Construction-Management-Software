{
  "name": "ross-built-cms",
  "version": "2.0.0",
  "description": "Ross Built Construction Management Software - React + Node.js",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node server/index.js",
    "client": "cd client && npm run dev",
    "start": "node server/index.js",
    "stop": "node server/scripts/stop.js",
    "restart": "node server/scripts/stop.js && node server/index.js",
    "build": "cd client && npm run build",
    "install:all": "npm install && cd client && npm install",
    "migrate": "node server/scripts/migrate.cjs",
    "migrate:status": "node server/scripts/migrate.cjs --status",
    "migrate:force": "node server/scripts/migrate.cjs --force",
    "db:start": "node server/scripts/migrate.cjs && node server/index.js",
    "test": "jest",
    "test:unit": "jest --testPathPatterns=unit",
    "test:e2e": "npx playwright test tests/e2e/",
    "test:e2e:all": "npx playwright test",
    "test:e2e:invoices": "npx playwright test tests/e2e/invoices.spec.ts",
    "test:e2e:draws": "npx playwright test tests/e2e/draws.spec.ts",
    "test:e2e:pos": "npx playwright test tests/e2e/purchase-orders.spec.ts",
    "test:e2e:nav": "npx playwright test tests/e2e/navigation.spec.ts",
    "test:e2e:ui": "npx playwright test tests/e2e/ --ui",
    "test:budget": "npx playwright test tests/budget-projected.spec.js",
    "test:sidebar": "npx playwright test tests/sidebar-navigation.spec.js",
    "test:ui": "npx playwright test --ui",
    "test:report": "npx playwright show-report",
    "lint": "npm run lint:server && npm run lint:client",
    "lint:server": "eslint server/ config/ --max-warnings 50",
    "lint:client": "cd client && npm run lint",
    "lint:fix": "eslint server/ config/ --fix && cd client && npm run lint -- --fix",
    "typecheck": "cd client && npx tsc --noEmit",
    "type-check": "cd client && npx tsc --noEmit",
    "restamp": "node server/documents/restamp.js",
    "restamp:dry": "node server/documents/restamp.js --dry-run",
    "docker:build": "docker build -t rossbuilt-cms .",
    "docker:run": "docker-compose up -d",
    "docker:dev": "docker-compose -f docker-compose.dev.yml up",
    "docker:stop": "docker-compose down",
    "docker:logs": "docker-compose logs -f app",
    "security:audit": "npm audit && node scripts/security-scan.js",
    "security:scan": "node scripts/security-scan.js",
    "security:scan:verbose": "node scripts/security-scan.js --verbose",
    "security:fix": "npm audit fix"
  },
  "author": "Ross Built Custom Homes",
  "license": "UNLICENSED",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.33.0",
    "@supabase/supabase-js": "^2.39.0",
    "axios": "^1.13.2",
    "canvas": "^3.2.1",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "mammoth": "^1.11.0",
    "multer": "^2.0.2",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.4",
    "pdf2pic": "^3.2.0",
    "pdfjs-dist": "^5.4.530",
    "pdfmake": "^0.3.3",
    "sharp": "^0.34.5",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "twilio": "^5.0.0",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@playwright/test": "^1.57.0",
    "concurrently": "^8.2.2",
    "eslint": "^9.32.0",
    "globals": "^15.15.0",
    "jest": "^30.2.0",
    "pg": "^8.16.3",
    "playwright": "^1.57.0",
    "puppeteer": "^24.36.1"
  },
  "type": "commonjs"
}
